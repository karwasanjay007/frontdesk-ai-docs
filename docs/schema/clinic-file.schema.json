{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrontDesk AI clinic file (version 2.0.1)",
  "description": "The clinic file as the server reads it (ClinicData in src/lib/types.ts): the file that ships with the app, or the copy saved from the staff page into the shared store. The required parts are the ones a clinic save is checked for (ClinicSchema in src/app/api/tickets/route.ts); a saved file may be at most 100,000 characters as JSON. Anything else in the file is kept as it is.",
  "type": "object",
  "required": ["clinic", "hours", "doctors", "services", "policies"],
  "properties": {
    "note": { "type": "string", "description": "Free text about the file." },
    "clinic": {
      "type": "object",
      "required": ["name", "address", "phone", "emergency_phone"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "landmark": { "type": "string" },
        "phone": { "type": "string", "minLength": 1, "description": "Also given when a ticket could not be recorded." },
        "emergency_phone": { "type": "string", "minLength": 1, "description": "First thing in an emergency reply." },
        "whatsapp": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "parking": { "type": "string" },
        "email": { "type": "string" },
        "website": { "type": "string" }
      }
    },
    "hours": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" },
      "description": "Each key names a day or a range of days; each value is the timing text."
    },
    "doctors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "days"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "days": { "type": "string" }
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "price"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "price": { "type": "string", "minLength": 1 },
          "note": { "type": "string" },
          "duration": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" }, "description": "Other names patients use for this service." }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "emergency_rules": { "type": "string" },
    "bot_rules": { "type": "array", "items": { "type": "string" } }
  }
}
