@startuml c4-context
!include <C4/C4_Context>
title FrontDesk AI: system context (C4 level 1, as built)

Person(patient, "Patient", "Asks the clinic a question on a phone or desktop browser, by typing or speaking")
Person(staff, "Front desk staff", "Opens /staff to answer tickets, call back and edit the clinic file")
System(frontdesk, "FrontDesk AI", "Patient chat at / and staff page at /staff. Answers only from the clinic file, opens tickets, hands hard questions to a human")
System_Ext(model, "OpenRouter, DeepSeek V4.1 Flash", "Rewords a drafted file answer; optional. Never sees the patient's words. Also reads a reply aloud (api/tts) and, as a backup, turns a recorded voice clip into text (api/transcribe)")
System_Ext(upstash, "Upstash Redis (ticket store)", "v1.3: tickets shared across devices, kept seven days; optional")
System_Ext(speechsvc, "Browser speech services", "Web Speech API: recognition and synthesis in the patient's browser")
System_Ext(whatsapp, "WhatsApp", "Chat with the clinic, opened from a wa.me link")
System_Ext(phone, "Clinic phone lines", "040 5550 0123 and the emergency line from the clinic file")

Rel(patient, frontdesk, "Asks questions, reads replies", "HTTPS")
Rel(staff, frontdesk, "Reads tickets, replies, edits the clinic file", "HTTPS")
Rel(frontdesk, model, "Asks for a reworded draft, 8 s limit; reply audio, 15 s; backup transcription, 12 s", "HTTPS, key on the server only")
Rel(frontdesk, upstash, "v1.3: stores and reads tickets", "HTTPS, REST, token on the server only")
Rel(frontdesk, speechsvc, "Listens and speaks on request")
Rel(patient, whatsapp, "Continues the conversation", "wa.me link")
Rel(patient, phone, "Calls in an emergency", "number shown first")

SHOW_LEGEND()
@enduml
