@startuml c4-context
!include <C4/C4_Context>
title FrontDesk AI 2.0.1: system context (C4 level 1, as built)

Person(patient, "Patient", "Types a question to the clinic on a phone or desktop browser")
Person(staff, "Front desk staff", "Opens /staff to answer tickets, call back, close tickets and edit the clinic file")
System(frontdesk, "FrontDesk AI", "Patient chat at / and staff page at /staff. Answers only from the clinic file, opens a ticket when a person is needed")
System_Ext(model, "AI provider (OpenAI-compatible)", "Optional. Answers one question from the clinic file as JSON; code checks the answer before it is used")
System_Ext(redis, "Redis of the host (shared store)", "In use on the live site: clinic file, tickets and messages, keys under one prefix")
System_Ext(postgres, "Postgres (Neon)", "Used when its address is set. Not connected on the live site")
System_Ext(phone, "Clinic phone lines", "The clinic number and the emergency number from the clinic file")

Rel(patient, frontdesk, "Asks questions, reads replies and staff replies", "HTTPS")
Rel(staff, frontdesk, "Reads tickets, replies, closes, edits the clinic file", "HTTPS")
Rel(frontdesk, model, "One attempt per question, stopped at 8 seconds", "HTTPS, key on the server only")
Rel(frontdesk, redis, "Reads and writes when no Postgres address is set", "HTTPS, REST, token on the server only")
Rel(frontdesk, postgres, "Reads and writes when its address is set", "SQL over HTTPS")
Rel(patient, phone, "Calls in an emergency", "number shown first in the reply")

SHOW_LEGEND()
@enduml
