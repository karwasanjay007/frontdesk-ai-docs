@startuml c4-component
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
skinparam wrapWidth 170
title FrontDesk AI: components of the patient chat

Person(patient, "Patient", "Chat page /")

Container_Boundary(chatpage, "Chat page scripts") {
  Component(chatui, "chat.js: chat", "JavaScript", "Questions, replies, quick replies, call-back form, Clinic info")
  Component(client, "chat.js: model step", "JavaScript", "askModel: posts the draft, waits 9 s")
  Component(voice, "chat.js: voice and Listen", "JavaScript", "Browser speech first, the server as backup")
  Component(addons, "layout.js, compact.js, callback-ask.js, mark-link.js", "JavaScript", "Clinic panel, + menu, call-back line, brand mark link")
}

Container_Boundary(core, "core.js (window.FD)") {
  Component(engine, "Rules engine and guard", "JavaScript", "answer(), answerFile(), guard(); hours, languages, quick replies")
  Component(tickets, "Tickets", "JavaScript", "addTicket, replyToTicket, setStatus")
  Component(store, "Clinic file", "JavaScript", "loadClinic, saveClinic, validateClinic")
}

Component(sync, "sync.js, shared.js", "JavaScript, both pages", "Tickets, messages and the clinic file to and from the server")

ContainerDb(ls, "localStorage", "Web Storage, JSON", "The frontdesk.* keys")
Container(file, "clinic-data.json", "Static JSON", "The shipped clinic file")
System(api, "api/, server functions", "Shown in the server diagram")

Rel_D(patient, chatui, "Types, taps or speaks")
Rel_L(addons, chatui, "Add controls")
Rel_D(chatui, engine, "Asks for the answer")
Rel_D(chatui, tickets, "A ticket per question")
Rel_R(chatui, client, "Asks for a reworded draft")
Rel_R(client, voice, "")
Rel_D(client, engine, "Checks the model's text again")
Rel_D(sync, tickets, "Merges server copies")
Rel_D(tickets, ls, "frontdesk.tickets")
Rel_D(store, ls, "frontdesk.clinic")
Rel_D(store, file, "Fetches")
Rel_D(client, api, "api/chat", "HTTPS, JSON")
Rel_D(voice, api, "api/tts, api/transcribe", "HTTPS, JSON")
Rel_D(sync, api, "tickets, messages, clinic, health", "HTTPS, JSON")
Lay_R(engine, tickets)
Lay_R(tickets, store)
Lay_D(tickets, sync)

SHOW_LEGEND()
@enduml
