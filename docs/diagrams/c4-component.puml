@startuml c4-component
!include <C4/C4_Component>
title FrontDesk AI 2.0.1: components of the answer and store modules (C4 level 3, as built)

Container(apichat, "POST /api/chat", "src/app/api/chat/route.ts")
Container(apitickets, "/api/tickets", "src/app/api/tickets/route.ts")
Container(apiother, "/api/messages, /api/clinic, /api/health", "Route handlers")

Container_Boundary(lib, "src/lib") {
  Component(answer, "answer.ts", "answerPatient", "The order per message: guards, booking, AI step, matcher")
  Component(guards, "guards.ts", "runGuards", "1 emergency (urgent ticket, P1). 2 medical advice and rule-break refusals (no ticket)")
  Component(i18n, "i18n.ts", "detectLanguage, localiseReply", "Hindi, Telugu, Hinglish or English from the script and words of the question")
  Component(matcher, "matcher.ts", "detectBooking, matchClinicFile", "3 booking request to a ticket (P2). 5 keyword answer with the label Answered from the clinic file; not in the file: needs human ticket (P3)")
  Component(booking, "booking-time.ts", "requestedLabel", "Requested day, calendar date in India and time, written on the ticket")
  Component(ai, "ai.ts", "askModel, acceptAiReply", "4 one attempt, 8 seconds, JSON checked with Zod. Rejects an unknown doctor, a figure for another service, a time for another day")
  Component(db, "db.ts", "storeMode and the store functions", "Picks the store: Postgres when its address is set, else Redis, else server memory. healthCheck")
  Component(kv, "kv.ts", "Redis over REST", "Keys under one prefix: clinic, tickets, msgs per chat")
  Component(desk, "desk.ts", "isStaff", "Optional desk lock: code compared as digests. Off on the live site")
  Component(types, "types.ts", "Types", "ClinicData, AnswerResult, MessageRow, TicketRow")
}

System_Ext(model, "AI provider (OpenAI-compatible)")
ContainerDb_Ext(redis, "Redis of the host", "Live store today")
ContainerDb_Ext(postgres, "Postgres (Neon)", "Used when its address is set")

Rel(apichat, answer, "answerPatient(message, clinic)")
Rel(apichat, db, "insertMessage, insertTicket, getClinicData; a failure is noted, never thrown")
Rel(apitickets, desk, "isStaff(request)")
Rel(apitickets, db, "listTickets, replyToTicket, closeTicket, saveClinicData")
Rel(apiother, db, "listMessages, getClinicData, healthCheck")
Rel(answer, i18n, "language of the question")
Rel(answer, guards, "first")
Rel(answer, matcher, "booking third, clinic file last")
Rel(answer, booking, "label for the ticket")
Rel(answer, ai, "fourth, only with a key")
Rel(answer, ai, "also drops a clock time without am or pm (keepsFileWording)")
Rel(ai, model, "HTTPS, key on the server only")
Rel(db, kv, "when no Postgres address is set")
Rel(kv, redis, "HTTPS REST, 6 second limit")
Rel(db, postgres, "SQL, when its address is set")

SHOW_LEGEND()
@enduml
