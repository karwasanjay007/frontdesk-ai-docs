@startuml j8-languages-and-voice
!include c4-sequence.iuml
title J8 Languages and voice
actor "Patient" as Patient <<person>>
box "In the patient's browser"
participant "Patient chat\n(chat.js,\ncompact.js)" as Chat <<container>>
participant "Rules engine\n(core.js)" as Core <<component>>
participant "Browser speech" as Sp <<external>>
end box
box "Vercel functions"
participant "api/transcribe.js" as Tr <<container>>
participant "api/tts.js" as Tts <<container>>
end box
participant "OpenRouter" as OR <<external>>

== The language ==
Patient -> Chat : chooses HI in\nthe language box
Chat -> Core : FD.setLang
Chat --> Patient : the labels and quick\nreplies are in Hindi
== Speaking a question ==
Patient -> Chat : taps "+", then "Speak\nyour question", and speaks
Chat -> Sp : start speech recognition\nin the chosen language
alt the browser's recognition answers
  Sp --> Chat : the words heard
else it does not start within 2.5 seconds, or its service refuses
  Chat -> Tr : POST /api/transcribe\n(a recorded clip\nand the language)
  Tr -> OR : the clip, to be\nturned into text
  Tr --> Chat : the text
end
note over Chat, Sp : the servers hear the patient only\nwhen the browser cannot
Chat -> Core : FD.answer(the words,\nclinic file, language)
Chat --> Patient : the reply in Hindi
== Listening to the reply ==
opt Listen pressed
  Patient -> Chat : taps "Listen"\nunder the reply
  alt the browser has a voice for the language
    Chat -> Sp : read the reply aloud
  else it has none, or the voice stays silent for 3 seconds
    Chat -> Tts : POST /api/tts (the reply's\ntext, 700 characters at most)
    Tts -> OR : the text, to be spoken
    Tts --> Chat : the sound as a WAV file
  end
  Chat --> Patient : the reply is heard;\nif both voices fail, "No voice\nfor this language on this device"
end
@enduml
