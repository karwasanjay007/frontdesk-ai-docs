@startuml c4-container
!include <C4/C4_Container>
title FrontDesk AI 2.0.1: containers (C4 level 2, as built)

Person(patient, "Patient")
Person(staff, "Front desk staff")

System_Boundary(fd, "FrontDesk AI (one Next.js App Router application)") {
  Container(chat, "Chat page", "React client component, route /", "ChatClient: greeting, six quick replies, question box, replies. Keeps only a chat id in the browser. Polls for staff replies every 3 seconds")
  Container(staffpage, "Staff page", "React client component, route /staff", "StaffClient: tickets with a reply box each, call-back list, close, clinic file editor. Reloads the list every 4 seconds")
  Container(apichat, "POST /api/chat", "Route handler, TypeScript, Zod", "Stores the message, runs the answer order, opens a ticket when needed, stores the reply. Always replies")
  Container(apitickets, "GET and POST /api/tickets", "Route handler, TypeScript, Zod", "Ticket list without chat ids; staff reply; close; checked clinic save; clinic reset. Optional desk lock")
  Container(apimessages, "GET /api/messages", "Route handler", "One chat's messages, read with its chat id")
  Container(apiclinic, "GET /api/clinic", "Route handler", "The clinic file in use; the shipped file when the store is down")
  Container(apihealth, "GET /api/health", "Route handler", "Names the store, says whether an AI key is set; 503 when not ok")
  Container(lib, "Answer and store modules", "TypeScript, src/lib", "answer, guards, i18n, matcher, booking-time, ai, db, kv, desk")
}

System_Ext(model, "AI provider (OpenAI-compatible)", "Optional")
ContainerDb_Ext(redis, "Redis of the host", "REST", "Live store today. Keys: clinic, tickets, msgs per chat, all under one prefix")
ContainerDb_Ext(postgres, "Postgres (Neon)", "SQL", "Used when its address is set; not connected on the live site. Tables clinic_data, messages, tickets")

Rel(patient, chat, "Types a question", "HTTPS")
Rel(staff, staffpage, "Replies, closes, edits", "HTTPS")
Rel(chat, apichat, "chatId, message", "JSON")
Rel(chat, apimessages, "Poll with chatId", "JSON")
Rel(chat, apiclinic, "Clinic name for the greeting", "JSON")
Rel(staffpage, apitickets, "List, reply, close, save, reset", "JSON, x-desk-code header when the lock is on")
Rel(staffpage, apiclinic, "Clinic file for the editor", "JSON")
Rel(apichat, lib, "answerPatient, insertMessage, insertTicket")
Rel(apitickets, lib, "listTickets, replyToTicket, closeTicket, saveClinicData, isStaff")
Rel(apimessages, lib, "listMessages")
Rel(apiclinic, lib, "getClinicData")
Rel(apihealth, lib, "healthCheck")
Rel(lib, model, "One attempt, 8 seconds, JSON reply", "HTTPS")
Rel(lib, redis, "When no Postgres address is set", "HTTPS REST")
Rel(lib, postgres, "When its address is set", "SQL over HTTPS")

SHOW_LEGEND()
@enduml
