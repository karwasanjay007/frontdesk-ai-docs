@startuml c4-container
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title FrontDesk AI: containers

Person(patient, "Patient", "Phone or desktop browser")
Person(staff, "Front desk staff", "Any browser, with the desk code")

System_Boundary(browser, "The browser") {
  Container(chat, "Chat page /", "Plain JavaScript", "core.js, chat.js and the add-on scripts")
  Container(staffui, "Staff page /staff", "Plain JavaScript", "core.js and the staff/ scripts")
  Container(both, "sync.js, shared.js", "Plain JavaScript, both pages", "Tickets, messages and the clinic file, to and from the server")
  ContainerDb(store, "Web Storage", "localStorage, sessionStorage", "Tickets, clinic file, settings; the desk code per tab")
}

System_Boundary(host, "Vercel project (static files and server functions)") {
  Container(static, "Static files", "HTML, CSS, JavaScript, JSON", "Pages, scripts, clinic-data.json; no build step")
  Container(aifn, "Chat and voice routes", "Server functions, Node.js", "api/chat, api/tts, api/transcribe")
  Container(datafn, "Tickets, messages and clinic routes", "Server functions, Node.js", "api/tickets, api/messages, api/clinic, through api/_store.js")
  Container(healthfn, "Health", "Server function, Node.js", "api/health: GET { ok, store, ai }")
}

System_Ext(openrouter, "OpenRouter", "Model gateway: wording, speech, transcription")
ContainerDb_Ext(neon, "Postgres on Neon", "SQL, @neondatabase/serverless", "Tables messages, tickets, clinic_data")
System_Ext(whatsapp, "WhatsApp", "wa.me link")

Rel_D(patient, chat, "Types, taps or speaks")
Rel_D(staff, staffui, "Reads, replies, edits the clinic file")
Rel_D(chat, store, "Tickets, clinic file")
Rel_D(staffui, store, "Tickets, clinic edits")
Rel(both, store, "Keys frontdesk.*")
Rel_U(static, chat, "Serves", "HTTPS")
Rel_U(static, staffui, "Serves", "HTTPS")
Rel_D(chat, aifn, "Draft to reword; speech as backup", "HTTPS, JSON")
Rel(chat, whatsapp, "Offers a link")
Rel_D(both, datafn, "x-patient-key or x-desk-code", "HTTPS, JSON")
Rel_D(both, healthfn, "Is there a store?", "HTTPS, JSON")
Rel_D(aifn, openrouter, "Model calls", "HTTPS, OPENROUTER_API_KEY")
Rel_D(datafn, neon, "SQL, 6 s per query", "HTTPS")
Rel_D(healthfn, neon, "ping")

Lay_R(chat, staffui)
Lay_R(staffui, both)
Lay_D(store, static)
Lay_D(browser, host)
Lay_R(aifn, datafn)
Lay_R(datafn, healthfn)

SHOW_LEGEND()
@enduml
