@startuml c4-container
!include <C4/C4_Container>
title FrontDesk AI: containers

Person(patient, "Patient", "Phone or desktop browser")
Person(staff, "Front desk staff", "Any browser, with the clinic's desk code")
System_Ext(openrouter, "OpenRouter", "Model gateway: deepseek/deepseek-v4.1-flash for wording, openai/gpt-audio-mini for speech, google/gemini-2.5-flash-lite for transcription")
System_Ext(whatsapp, "WhatsApp", "wa.me or web.whatsapp.com link")
ContainerDb_Ext(neon, "Postgres on Neon (shared store)", "SQL, @neondatabase/serverless", "Tables messages, tickets, clinic_data; DATABASE_URL in the environment")

System_Boundary(host, "Vercel project (static files and server functions)") {
  Container(static, "Static files", "HTML, CSS, JavaScript, JSON", "index.html, staff/index.html, the scripts and styles, clinic-data.json; no build step")
  Container(chatfn, "api/chat", "Server function, Node.js", "GET: warm-up. POST: takes the draft, its facts, the language and the clinic file, never the patient's message; one model call, temperature 0, 8 s limit; runs the guard from core.js before a reply leaves; 60 requests a minute per address")
  Container(ticketsfn, "api/tickets", "Server function, Node.js", "GET a patient's own tickets with the browser key, or every device's with the desk code. POST up to 20 tickets: cleaned, then merged with the stored copy")
  Container(msgfn, "api/messages", "Server function, Node.js", "POST one chat message with the browser key. GET a chat: its owner's key or the desk code")
  Container(clinicfn, "api/clinic", "Server function, Node.js", "GET the clinic file in use (saved, else shipped). POST with the desk code saves or resets it for every device")
  Container(healthfn, "api/health", "Server function, Node.js", "GET { ok, store, ai }")
  Container(tts, "api/tts", "Server function, Node.js", "POST the bot's reply text, at most 700 characters; returns audio/wav; 15 s limit")
  Container(transcribe, "api/transcribe", "Server function, Node.js", "POST a recorded WAV clip; returns its text; 12 s limit")
  Container(storemod, "api/_store.js", "Node.js module, not a route", "mode(): postgres when DATABASE_URL is set, else redis when the Redis REST variables are set, else none. Tickets, messages, the clinic file, the request counter")
}

System_Boundary(browser, "The browser") {
  Container(chat, "Chat page /", "Plain JavaScript", "core.js (rules engine, guard, tickets) and chat.js (chat, model step, voice, Listen, call-back form, clinic panel); layout.js, compact.js, callback-ask.js, mark-link.js add to the page")
  Container(staffui, "Staff page /staff", "Plain JavaScript", "core.js and staff/staff.js: ticket queue, reply box, Clear all with Undo, clinic file editor; staff/tools.js (search, filters, figures, CSV, notes, alerts) and staff/form.js (Edit with a form) add to the page")
  Container(sync, "sync.js", "Plain JavaScript, both pages", "Mirrors tickets to api/tickets every 2.5 s; the Desk code box and the switch Show tickets from all devices; goes quiet when the store is missing or slow")
  Container(shared, "shared.js", "Plain JavaScript, both pages", "Fetches the clinic file from api/clinic at start, on tab return and before an answer; sends every message to api/messages; sends staff Save and Reset to the server")
  ContainerDb(ls, "localStorage", "Web Storage, JSON", "This browser's copy: frontdesk.tickets, frontdesk.clinic, the patient id, language, theme, the browser key, staff notes and switches")
  ContainerDb(ss, "sessionStorage", "Web Storage", "frontdesk.deskcode: the desk code, for this tab only")
  Container(speech, "Browser speech", "Built into the browser", "Recognition and synthesis; backup paths are api/transcribe and api/tts")
}

Rel(patient, chat, "Types, taps or speaks")
Rel(staff, staffui, "Reads, replies, edits the clinic file")
Rel(static, chat, "Serves", "HTTPS")
Rel(static, staffui, "Serves", "HTTPS")
Rel(chat, chatfn, "GET warm-up; POST draft, facts, language, clinic file (waits 9 s)", "HTTPS, JSON")
Rel(chat, tts, "POST reply text when the browser has no voice", "HTTPS, JSON")
Rel(chat, transcribe, "POST a recorded clip when browser recognition fails", "HTTPS, JSON")
Rel(chat, speech, "Listens and speaks on request")
Rel(chat, whatsapp, "Offers a link with the question written in")
Rel(chat, ls, "Writes tickets, reads staff replies and the clinic file")
Rel(staffui, ls, "Reads tickets, writes replies, status and clinic edits")
Rel(sync, ls, "Reads and writes tickets; keeps frontdesk.synckey and frontdesk.alldevices")
Rel(sync, ss, "Keeps frontdesk.deskcode")
Rel(sync, ticketsfn, "Chat: x-patient-key, own tickets. Staff: x-desk-code, every device's tickets", "HTTPS, JSON")
Rel(sync, healthfn, "Staff page with no desk code: asks whether there is a store", "HTTPS, JSON")
Rel(shared, clinicfn, "GET the clinic file; POST save or reset with the desk code", "HTTPS, JSON")
Rel(shared, msgfn, "POST each patient message, bot reply and staff reply", "HTTPS, JSON")
Rel(shared, ls, "Writes frontdesk.clinic and its marks, frontdesk.msgseen")
Rel(chatfn, openrouter, "POST /api/v1/chat/completions", "HTTPS, OPENROUTER_API_KEY")
Rel(tts, openrouter, "Streams audio", "HTTPS, OPENROUTER_API_KEY")
Rel(transcribe, openrouter, "Audio to text", "HTTPS, OPENROUTER_API_KEY")
Rel(ticketsfn, storemod, "tickets")
Rel(msgfn, storemod, "messages")
Rel(clinicfn, storemod, "clinic_data")
Rel(healthfn, storemod, "ping")
Rel(storemod, neon, "SQL as tagged templates, 6 s per query", "HTTPS")

SHOW_LEGEND()
@enduml
