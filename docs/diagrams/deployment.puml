@startuml deployment
!include <C4/C4_Deployment>
title FrontDesk AI 2.0.1: deployment (as live since 27 Nov 2026)

Deployment_Node(browserP, "Patient's browser", "Phone or desktop") {
  Container(chat, "Chat page /", "React", "Keeps a chat id in local storage, nothing else")
}
Deployment_Node(browserS, "Staff browser", "Desktop or phone") {
  Container(staffpage, "Staff page /staff", "React", "Keeps the desk code for the session only, when the lock is on")
}
Deployment_Node(host, "Vercel", "Serverless host") {
  Deployment_Node(fn, "Server functions", "Node.js, Next.js App Router") {
    Container(routes, "Routes", "TypeScript", "/api/chat, /api/tickets, /api/messages, /api/clinic, /api/health")
    Container(memory, "Server memory", "Last resort store", "Used only when no store is set up. On the host each instance has its own, so health answers not ok (503)")
  }
  Deployment_Node(env, "Environment", "Names only") {
    Container(vars, "Settings", "Environment variables", "DATABASE_URL, KV_REST_API_URL, KV_REST_API_TOKEN, AI_API_KEY, AI_BASE_URL, AI_MODEL, OPENROUTER_API_KEY, AI_TIMEOUT_MS, FRONTDESK_DESK_LOCK, FRONTDESK_DESK_CODE")
  }
  ContainerDb(redis, "Redis of the host", "REST", "IN USE on the live site. Second in the store order")
}
Deployment_Node(neon, "Neon", "Postgres") {
  ContainerDb(postgres, "Postgres", "SQL", "First in the store order, used when DATABASE_URL is set. NOT connected on the live site")
}
Deployment_Node(aihost, "AI provider", "OpenAI-compatible") {
  Container(model, "Model", "Chat completions", "Optional. One attempt, stopped at 8 seconds")
}

Rel(chat, routes, "HTTPS, JSON")
Rel(staffpage, routes, "HTTPS, JSON")
Rel(routes, vars, "reads on each request")
Rel(routes, redis, "HTTPS REST, token on the server only")
Rel(routes, postgres, "only when its address is set")
Rel(routes, model, "HTTPS, key on the server only")
Rel(routes, memory, "only when no store is set up")

SHOW_LEGEND()
@enduml
