@startuml data-model
title FrontDesk AI data model: the server's tables

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 14
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam titleFontSize 18
skinparam titleFontColor #0B5D63
skinparam ArrowColor #0B5D63
skinparam ArrowFontColor #2F4245
skinparam ArrowThickness 1.4
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0B5D63
  BorderThickness 1.6
  HeaderBackgroundColor #E3F0F1
  FontColor #132326
  AttributeFontColor #2F4245
  StereotypeFontColor #0B5D63
}
skinparam note {
  BackgroundColor #F4F8F8
  BorderColor #9BBFC2
  FontColor #2F4245
  FontSize 12
}
skinparam package {
  BorderColor #9BBFC2
  FontColor #0B5D63
  BackgroundColor #FFFFFF
}
hide circle
hide methods
set separator none
top to bottom direction

package "Server: Postgres on Neon, through api/_store.js" {
  entity tickets {
    {field} <b>id</b> : TEXT, primary key
    {field} patient : TEXT
    {field} owner : TEXT  (hash of the browser key)
    {field} status : TEXT
    {field} priority : TEXT  (urgent | normal)
    {field} text : TEXT  (the question)
    {field} reply : TEXT
    {field} data : JSONB  (the whole ticket)
    {field} created_at : BIGINT
    {field} updated_at : BIGINT
  }
  entity messages {
    {field} <b>id</b> : BIGSERIAL, primary key
    {field} chat_id : TEXT
    {field} role : TEXT  (patient | bot | staff)
    {field} text : TEXT  (at most 6,000 characters)
    {field} source : TEXT
    {field} owner : TEXT  (hash of the browser key)
    {field} created_at : BIGINT
  }
  entity clinic_data {
    {field} <b>id</b> : INTEGER  (always 1, the only row)
    {field} data : JSONB  (the edited clinic file)
    {field} updated_at : BIGINT
  }
}

tickets "0..*" -down- "0..*" messages : tickets.patient = messages.chat_id\n(the patient id); the same owner
messages -[hidden]down- clinic_data

note right of tickets
  <b>Written by</b> sync.js, POST /api/tickets
  A merge keeps every staff reply; the
  status further along wins. Patient,
  question, bot reply, created and
  owner never change once stored.
  Deleted seven days after it was made.
end note

note right of messages
  <b>Written by</b> shared.js, POST /api/messages
  The question, the bot reply and
  each staff reply, one row each.
  Deleted seven days after it was made.
end note

note right of clinic_data
  <b>Written by</b> shared.js, POST /api/clinic
  (desk code). No link to the other tables
  and no expiry. When there is no row,
  the shipped clinic-data.json is used.
end note
@enduml
