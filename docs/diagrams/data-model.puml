@startuml data-model
!include c4-erd.iuml
title FrontDesk AI data model: the server
top to bottom direction

package "Postgres on Neon (server)" <<store>> {
  entity "tickets" as tickets <<table>> {
    * id : TEXT <<PK>>
    --
    * patient : TEXT DEFAULT ''
    * owner : TEXT DEFAULT ''
    * status : TEXT
    * priority : TEXT DEFAULT 'normal'
    * text : TEXT DEFAULT ''
    * reply : TEXT DEFAULT ''
    * data : JSONB
    * created_at : BIGINT
    * updated_at : BIGINT
    ..
    index tickets_owner (owner)
  }
  entity "messages" as messages <<table>> {
    * id : BIGSERIAL <<PK>>
    --
    * chat_id : TEXT
    * role : TEXT
    * text : TEXT
    * source : TEXT DEFAULT ''
    * owner : TEXT DEFAULT ''
    * created_at : BIGINT
    ..
    index messages_chat (chat_id, id)
  }
  entity "clinic_data" as clinic <<table>> {
    * id : INTEGER <<PK>> CHECK (id = 1)
    --
    * data : JSONB
    * updated_at : BIGINT
  }
}

package "Redis over REST (fallback when DATABASE_URL is not set)" <<store>> {
  entity "fd:idx" as ridx <<key>> {
    * key : fd:idx <<PK>>
    --
    * type : SORTED SET
    * member : ticket id
    * score : created (ms)
  }
  entity "fd:t:<U+003C>id>" as rt <<key>> {
    * key : fd:t:<id> <<PK>>
    --
    * type : STRING
    * value : the whole ticket, JSON
    * expiry : 7 days
  }
  entity "fd:o:<U+003C>owner>" as ro <<key>> {
    * key : fd:o:<owner hash> <<PK>>
    --
    * type : SET
    * member : ticket id
    * expiry : 7 days
  }
  entity "fdb:mo:<U+003C>chat>" as rmo <<key>> {
    * key : fdb:mo:<chat id> <<PK>>
    --
    * type : STRING
    * value : owner hash (set once, NX)
    * expiry : 7 days
  }
  entity "fdb:m:<U+003C>chat>" as rm <<key>> {
    * key : fdb:m:<chat id> <<PK>>
    --
    * type : LIST
    * item : message JSON {id, chat_id,
      role, text, source, created_at}
    * expiry : 7 days, last 400 kept
  }
  entity "fdb:clinic" as rc <<key>> {
    * key : fdb:clinic <<PK>>
    --
    * type : STRING
    * value : the edited clinic file, JSON
  }
  entity "fd:rl:<U+003C>key>:<U+003C>minute>" as rl <<key>> {
    * key : fd:rl:<key>:<minute> <<PK>>
    --
    * type : STRING (INCR counter)
    * expiry : 70 seconds
  }
}

tickets }o..o{ messages : "tickets.patient = messages.chat_id\n(the patient id); same owner hash"
messages -[hidden]down- clinic
clinic -[hidden]down- ridx

ridx ||..o{ rt : "lists by id,\nnewest 300"
ro ||..o{ rt : "a browser's\ntickets by id"
rt -[hidden]down- rmo
rmo ||..|| rm : "same chat id:\nwho owns the chat"
rm -[hidden]down- rc
rc -[hidden]right- rl

note right of tickets
  <b>data</b> holds the whole ticket as JSON;
  the other columns are copies for
  queries. priority is urgent when the
  status is urgent, else normal.
  <b>Who can read:</b> a patient's browser
  reads rows whose owner is the SHA-256
  hash of its key and whose patient is its
  patient id; staff read every row with
  the desk code. owner never leaves.
  <b>Retention:</b> rows older than 7 days
  are deleted after every write.
end note

note right of messages
  role is patient, bot or staff; text
  at most 6,000 characters.
  <b>Who can read:</b> the browser whose key
  hash is the owner of the chat's first
  row. A read returns 400 at most,
  oldest first.
  <b>Retention:</b> rows older than 7 days
  are deleted after every insert.
end note

note right of clinic
  One row at most. <b>data</b> is the edited
  clinic file, under 100,000 characters,
  checked before it is saved. Anyone may
  read it; only the desk code saves or
  resets it. A reset deletes the row and
  the shipped clinic-data.json is used.
  No expiry.
end note

note right of rm
  Used only when no DATABASE_URL is set
  and the Redis REST address and token
  are. Same rules and limits as the
  tables above. The request counter
  fd:rl uses Redis whenever it is set,
  in either mode.
end note

legend right
  <b>Key</b>
  PK primary key
  * mandatory (NOT NULL), NULL optional
  solid line: enforced by the database
  dotted line: linked by value only
  ||..o{ one to zero or many
  }o..o{ many to many, by value
endlegend
@enduml
