@startuml data-model
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 10
skinparam class {
  BorderColor #0B5D63
  BackgroundColor #E6F1F2
  ArrowColor #0B5D63
}
skinparam note {
  BorderColor #C97A1D
  BackgroundColor #FFF6E8
}
hide circle
hide methods
title FrontDesk AI 2.0.1: data model (types.ts, migrations/001_init.sql, kv.ts)

class "clinic_data (the clinic file)" as Clinic {
  id : integer, one row
  json : ClinicData
  --
  clinic : name, address, phone, emergency_phone, ...
  hours : day or range -> timing text
  doctors[] : name, role, days
  services[] : name, price, note, duration, aliases
  policies : name -> text
  emergency_rules, bot_rules (optional)
}

class "messages" as Message {
  id : text
  chat_id : text
  role : user | assistant | staff
  text : text
  source : clinic-file | clinic-file-unsure | ai | guard | staff | null
  created_at : time
}

class "tickets" as Ticket {
  id : text
  chat_id : text (never sent to the staff page)
  status : urgent | needs human | answered | closed
  priority : P1 | P2 | P3
  text : the question, with the requested day, date and time for a booking
  reply : the staff reply, or null
  created_at : time
}

class "Chat (not stored as a row)" as Chat {
  chat id : made in the patient's browser,
  kept in its local storage
}

Chat "1" -- "0..*" Message : chat_id
Chat "1" -- "0..*" Ticket : chat_id
Ticket "1" -- "0..1" Message : a staff reply adds one message with role staff
Clinic ..> Message : every answer is worked out from the file in use

note bottom of Ticket
P1 urgent: emergency. P2 needs human: booking request.
P3 needs human: not in the clinic file.
A staff reply sets answered; Close sets closed.
end note

note bottom of Clinic
The same three shapes in each store, first one set up wins:
1 Postgres tables, when its address is set (not connected on the live site)
2 Redis keys under one prefix: clinic, tickets (hash), msgs per chat (list). Live today
3 server memory
With an empty store the clinic file that ships with the app is used.
end note
@enduml
